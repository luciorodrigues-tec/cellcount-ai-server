# ==============================================================================
# CELLCOUNT ENTERPRISE BACKEND
# Environment Configuration Template
# ==============================================================================
#
# SECURITY RULES
# - This file contains placeholders and safe defaults only.
# - NEVER commit real credentials or production secrets.
# - Keep the real .env outside version control.
# - SESSION_SIGNING_SECRET and API_TOKEN must be independent secrets.
# - Never embed server secrets in Flutter, APK, IPA, Web, or other public clients.
#
# ==============================================================================


# ------------------------------------------------------------------------------
# RUNTIME
# ------------------------------------------------------------------------------

NODE_ENV=production
PORT=3000


# ------------------------------------------------------------------------------
# CLEANUP-001.1 — AUTHENTICATION & SESSION SECURITY
# ------------------------------------------------------------------------------

# Legacy shared API credential.
#
# Transitional compatibility only.
# Required only while ALLOW_LEGACY_API_TOKEN=true.
#
# Do NOT embed this value in Flutter/APK/IPA/Web clients.
# After migration of supported clients:
#   1. rotate/revoke the historical API token;
#   2. set ALLOW_LEGACY_API_TOKEN=false.
API_TOKEN=

# Cryptographic authority for short-lived session credentials.
#
# REQUIRED in production.
# Must be independent from API_TOKEN and OPENAI_API_KEY.
# Generate a high-entropy random secret containing at least 32 bytes.
# Never commit the real value.
SESSION_SIGNING_SECRET=

# Lifetime, in seconds, of a device-bound session credential.
# Current production contract: 15 minutes.
SESSION_TOKEN_TTL_SECONDS=900

# Maximum session-issuance requests permitted by the dedicated limiter
# within the configured rate-limit window.
SESSION_ISSUE_MAX_REQUESTS=12

# Legacy authentication migration gate.
#
# Transitional rollout:
#   true  = old API_TOKEN clients remain temporarily compatible.
#
# Final post-cutover state:
#   false = only the new session boundary is accepted for client traffic.
#
# Secure default for new/final production deployments:
ALLOW_LEGACY_API_TOKEN=false


# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------

# Explicit comma-separated trusted origins.
# Wildcard origins are rejected by the security boundary.
CORS_ALLOWED_ORIGINS=https://app.example.com


# ------------------------------------------------------------------------------
# OPENAI
# ------------------------------------------------------------------------------

# Server-side only.
# Never expose this key to Flutter or another public client.
OPENAI_API_KEY=

# Keep exactly ONE OPENAI_MODEL declaration in this file.
# Set the actual production model through the deployment environment.
OPENAI_MODEL=gpt-4.1


# ------------------------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------------------------

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
AI_RATE_LIMIT_MAX_REQUESTS=12


# ------------------------------------------------------------------------------
# INF-SCALE-001.1B — DISTRIBUTED ANALYSIS-SESSION AUTHORITY
# ------------------------------------------------------------------------------

# Local/test default:
#   filesystem
#
# Horizontally scaled production:
#   postgres
#
# Do not enable horizontal scaling while relying on process-local/filesystem
# state as the authoritative distributed session store.
ANALYSIS_SESSION_STORAGE_PROVIDER=filesystem

# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_SSL_MODE=require
# ANALYSIS_SESSION_DB_POOL_MAX=10
# ANALYSIS_SESSION_DB_IDLE_TIMEOUT_MS=30000
# ANALYSIS_SESSION_DB_CONNECTION_TIMEOUT_MS=10000
# CELLCOUNT_HORIZONTAL_SCALE=false


# ------------------------------------------------------------------------------
# INF-SCALE-001.2H-D — PRODUCTION CAPACITY CALIBRATION
# ------------------------------------------------------------------------------

# Calibration harness variables are intended for controlled operational use.
# Never commit actual production credentials or private file-system paths.

# CELLCOUNT_CALIBRATION_BASE_URL=https://api.example.com
# CELLCOUNT_CALIBRATION_API_TOKEN=
# CELLCOUNT_CALIBRATION_IMAGE=C:\\path\\to\\validation.jpg
# CELLCOUNT_CALIBRATION_SPECIMEN_TYPE=PERIPHERAL_BLOOD
# CELLCOUNT_CALIBRATION_EXPECTED_WORKERS=4
# CELLCOUNT_CALIBRATION_LEVEL=25
# CELLCOUNT_CALIBRATION_SAMPLE_INTERVAL_MS=1500
# CELLCOUNT_CALIBRATION_CONFIRM=I_UNDERSTAND_PRODUCTION_CAPACITY_CALIBRATION


# ------------------------------------------------------------------------------
# INF-SCALE-001.2H-F — AUTOSCALING SAFETY GATE
# ------------------------------------------------------------------------------

# FAIL-CLOSED defaults.
#
# Do not enable autoscaling merely by changing CELLCOUNT_AUTOSCALING_ENABLED.
# Activation remains subject to the corresponding production certification,
# telemetry, fencing, capacity, and rollback gates.

CELLCOUNT_AUTOSCALING_ENABLED=false
CELLCOUNT_AUTOSCALING_KILL_SWITCH=true
CELLCOUNT_AUTOSCALING_2H_E_CERTIFIED=false

CELLCOUNT_AUTOSCALING_MIN_WORKERS=4
CELLCOUNT_AUTOSCALING_MAX_WORKERS=6
CELLCOUNT_AUTOSCALING_MAX_STEP_UP=1

CELLCOUNT_AUTOSCALING_COOLDOWN_MS=180000
CELLCOUNT_AUTOSCALING_REQUIRED_STABLE_SAMPLES=3
CELLCOUNT_AUTOSCALING_TELEMETRY_MAX_AGE_MS=15000
CELLCOUNT_AUTOSCALING_EVALUATION_INTERVAL_MS=5000
